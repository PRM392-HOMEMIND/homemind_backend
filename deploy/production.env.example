# Server-only /etc/homemind/api.env. Never copy actual local credentials here.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://homemind_app:CHANGE_ME@db:5432/homemind?connect_timeout=5&pool_timeout=5
AUTH_ACCESS_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES
AUTH_REFRESH_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES
AUTH_RESET_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES
AUTH_ISSUER=https://api.homemind.vn
AUTH_AUDIENCE=homemind-mobile
AUTH_REQUIRE_VERIFICATION=false
AUTH_DEV_RESET_DELIVERY=false
AUTH_RATE_LIMIT=20
TRUSTED_PROXY_IP=172.28.42.1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Migrator connection belongs in a separate /etc/homemind/migration.env only.
# MIGRATION_DATABASE_URL=postgresql://homemind_migrator:CHANGE_ME@db:5432/homemind
# Stage only this complete admin group using the trusted environment revision helper.
ADMIN_DATABASE_URL=
ADMIN_WEB_ORIGINS=
