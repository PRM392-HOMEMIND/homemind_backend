# Use one ignored .env for local setup. Back up existing .env/.env.local before consolidating.
# Never use these placeholders as real credentials or overwrite existing valid secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://homemind_app:CHANGE_ME@127.0.0.1:5432/homemind
MIGRATION_DATABASE_URL=postgresql://homemind_migrator:CHANGE_ME@127.0.0.1:5432/homemind
AUTH_ACCESS_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES
AUTH_REFRESH_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES
AUTH_RESET_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_RESET_TTL_SECONDS=900
AUTH_ISSUER=homemind
AUTH_AUDIENCE=homemind-mobile
# Email verification is enforced by account state; no raw reset disclosure.
AUTH_DEV_RESET_DELIVERY=false
EMAIL_DELIVERY_MODE=disabled
INFOBIP_BASE_URL=https://YOUR_ACCOUNT.api.infobip.com
INFOBIP_API_KEY=CHANGE_ME_SERVER_SIDE_ONLY
INFOBIP_EMAIL_FROM=no-reply@your-verified-domain.example
AUTH_OTP_SECRET=CHANGE_ME_INDEPENDENT_RANDOM_SECRET_AT_LEAST_32_BYTES
EMAIL_WORKER_CONCURRENCY=4
EMAIL_PROVIDER_TIMEOUT_MS=8000
AUTH_OTP_SEND_15M=5
AUTH_OTP_SEND_HOUR=10
AUTH_OTP_IP_15M=20
AUTH_OTP_GLOBAL_MINUTE=100
AUTH_RATE_LIMIT=300
DEV_PERSON_PASSWORD=CHANGE_ME
DEV_STORE_PASSWORD=CHANGE_ME
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# payOS is server-only. Enable only with the channel's three real credentials.
PAYOS_ENABLED=false
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Namespace 1 is local; production must use a separately reserved namespace.
BILLING_ORDER_NAMESPACE=1
# SYSTEM_ADMIN is disabled unless both fields are explicitly configured.
# Dedicated read role; never reuse DATABASE_URL or a superuser/migrator credential.
# Example when explicitly enabling admin: postgresql://homemind_admin_api:<password>@127.0.0.1:5432/<local-db>
ADMIN_DATABASE_URL=
ADMIN_WEB_ORIGINS=
# Homepage feedback popup (optional; the defaults below are what production runs).
# Exact browser origins allowed to call /v1/public/feedback-popup (comma separated, max 5, https only in production).
PUBLIC_WEB_ORIGINS=https://homemind.vn
# Per client address, per minute.
FEEDBACK_POPUP_SUBMIT_RATE_LIMIT=5
FEEDBACK_POPUP_CONFIG_RATE_LIMIT=60
# Seconds between reconciliation passes; 0 disables the worker (access is still resolved at read time).
FEEDBACK_POPUP_RECONCILE_SECONDS=15
# Documented default local port bindings and debug flags
